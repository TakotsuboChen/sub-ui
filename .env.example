# Sub-UI Server Configuration
SUBUI_HOST=0.0.0.0
SUBUI_PORT=8080
SUBUI_PUBLIC_URL=https://sub.example.com

# Database: sqlite (default) or postgres
SUBUI_DB_DRIVER=sqlite
SUBUI_DB_DSN=data/sub-ui.db
# SUBUI_DB_DRIVER=postgres
# SUBUI_DB_DSN=host=localhost user=subui password=secret dbname=subui port=5432 sslmode=disable

# Security (leave JWT_SECRET empty to auto-generate and persist in DB)
SUBUI_JWT_SECRET=
SUBUI_LOG_LEVEL=info

# Background sync interval in seconds (default 30)
SUBUI_SYNC_INTERVAL=30

# Optional initial admin seed (only used when database has 0 users)
SUBUI_ADMIN_USER=
SUBUI_ADMIN_PASS=
